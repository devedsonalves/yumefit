{
  "name": "api",
  "version": "1.0.0",
  "main": "index.js",
  "license": "MIT",
  "scripts": {
    "dev": "npx tsx watch ./src/shared/infrastructure/http/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node -r ./scripts/register-paths.js ./dist/shared/infrastructure/http/server.js",
    "migration:run": "node scripts/run-migrations.js run",
    "migration:revert": "node scripts/run-migrations.js revert",
    "migration:show": "node scripts/run-migrations.js show",
    "migration:create": "npx ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js migration:create",
    "migration:generate": "npx ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js migration:generate",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:integration": "jest --config jest.integration.config.js --runInBand --forceExit"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.2",
    "@types/express": "^4.17.8",
    "@types/ioredis": "^4.17.8",
    "@types/jest": "^29",
    "@types/jsonwebtoken": "^8.5.0",
    "@types/redis": "^2.8.28",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/supertest": "^6.0.3",
    "@types/uuid": "^8.3.4",
    "jest": "^29.7.0",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.9",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^3.9.0",
    "tsx": "^4.21.0",
    "typescript": "^4.0.5"
  },
  "dependencies": {
    "@scalar/express-api-reference": "^0.9.7",
    "@types/cookie-parser": "^1.4.10",
    "bcryptjs": "^2.4.3",
    "celebrate": "^13.0.4",
    "class-transformer": "^0.3.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^8.2.0",
    "express": "^4.17.1",
    "express-async-errors": "^3.1.1",
    "ioredis": "^4.19.2",
    "jsonwebtoken": "^8.5.1",
    "ora": "^5.1.0",
    "pg": "^8.4.2",
    "rate-limiter-flexible": "^2.1.13",
    "redis": "^3.0.2",
    "reflect-metadata": "^0.1.13",
    "swagger-jsdoc": "^6.2.8",
    "tsyringe": "^4.4.0",
    "typeorm": "^0.2.29",
    "uuid": "^8.3.2",
    "uuidv4": "^6.2.5"
  }
}
